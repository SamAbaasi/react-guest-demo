{
  "name": "react-guest-demo",
  "version": "1.0.0",
  "private": true,
  "description": "React components inside a Preact host (bpmn-io form-js): bridge lifecycle bugs and Preact duplication, reproduced live.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/vendor-panel.mjs",
    "dev": "vite",
    "dev:noalias": "vite --config vite.noalias.config.js",
    "dev:onepreact": "vite --config vite.onepreact.config.js",
    "build": "node scripts/build-all.mjs",
    "demo": "npm run build && vite preview --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpmn-io/form-js-editor": "1.21.2",
    "@bpmn-io/form-js-viewer": "1.21.2",
    "@bpmn-io/properties-panel": "3.40.6",
    "preact": "10.29.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "26.1.0",
    "vite": "8.0.3",
    "vitest": "5.0.3"
  }
}
